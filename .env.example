PORT=10000
# Paste entire session.json content as single line OR base64, or path
SESSION_JSON={"uuids": {...}, "authorization_data": {"sessionid": "..."}}

# Optional: which account to scrape. If empty, scrapes your own feed
TARGET_USERNAME=

# Optional: protect /upload with secret (UptimeRobot must send ?secret=xxx or header X-Upload-Secret)
UPLOAD_SECRET=mysecret123

# Optional: amount to scrape per run
SCRAPE_AMOUNT=10

# Optional: extra caption added to every repost
EXTRA_CAPTION=Follow for more 🔥

